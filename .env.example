# API connection
PANGOLIN_API_URL=http://pangolin:3001/api/v1

# Traefik configuration
TRAEFIK_CONF_DIR=/conf

# Database
DB_PATH=/data/middleware.db

# Server
PORT=3456

# Logging
LOG_LEVEL=info

# Optional admin authentication (disabled by default).
# When enabled, the UI and every /api route require HTTP basic auth.
# /health stays open for the container healthcheck.
# Traefik's HTTP provider must send the same Authorization header when polling
# /api/v1/traefik-config. Do not commit a real token.
# MM_AUTH_ENABLED=false
# MM_AUTH_USER=admin
# MM_AUTH_TOKEN=replace-with-a-long-random-token